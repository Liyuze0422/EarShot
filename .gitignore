# ── 环境与运行产物 ─────────────────────────────────────────────
.venv/
__pycache__/
*.py[cod]
.pipcache/
.wheels/
.tmp/
logs/
.runtime_port
.ui_pid

# ── ASR 模型（约 230MB，用 tools/download_model.py 下载）────────
models/
*.onnx

# ── 只属于你本机的配置：绝对不要提交 ──────────────────────────
config/settings.json
# 备份/临时变体也要挡：写配置的脚本容易留下 .bak，
# 它和 settings.json 内容一样（含本机路径），漏一个就是隐私事故。
config/settings.json*
config/*.bak
config/api_key.txt
config/company.md
config/known_terms.md
config/never_used.md
config/terms_review.md
# 你的私有词表（项目名、领域术语）：只属于你本机，仓库里放的是 .example 版本
config/topic_terms.json
config/domain_words.txt

# ── 你自己的面试材料、会话记录、测试产物 ──────────────────────
knowledge/*
!knowledge/README.md
!knowledge/examples/
!knowledge/examples/**
*.jsonl
tests/_out/
tests/regress_expect.json
tests/quality_sample.json
# 真实提问 / 合成提问：含面试原文与你的材料名 —— 提交上去就是事故
tests/real_questions.json
tests/synthetic_questions.json
tests/*questions*.json

# 题库：由你的材料自动生成（tools/build_bank.py），内容是**你的项目问答原文**。
# 它和知识库材料同等级别 —— 提交上去等于把材料发到公开仓库。踩过一次，见 CHANGELOG 0.9.3。
知识库/
bank.json
*题库*.json

# 依赖你私人样本的检查脚本：regress.py 会在缺失时自动跳过。
# 它们的内容贴着你的材料（外名词样本、期望答案），和 tests/*.json 同级。
tools/test_gap_fp.py
tools/test_answer_check.py
tools/test_faults.py

# 录音与转写原文：留在本地，永远不要进仓库
_realdata/
*.wav
*.mp3
*.m4a
*.flac
*.srt
*.vtt

# ── 编辑器 ────────────────────────────────────────────────────
.vscode/
.idea/
*.swp

# 测试与自检产物
.pytest_cache/
ui/.selftest*.png
ui/.live.png
